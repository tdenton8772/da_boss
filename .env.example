AUTH_PASSWORD=change-me-to-a-strong-password
SESSION_SECRET=change-me-to-a-random-32-char-string
NTFY_TOPIC=da-boss
PORT=3847
ANTHROPIC_ADMIN_API_KEY=
# Postgres connection. Locally, run the da_boss PG in the docker-desktop cluster
# (k8s/postgres.yaml) and port-forward svc/postgres to localhost:5432.
DATABASE_URL=postgres://daboss:CHANGE_ME@localhost:5432/daboss

# Credential-vault cipher (LocalAesCipher). 32-byte key, base64: `openssl rand -base64 32`
CRYPTO_PROVIDER=local
DABOSS_CIPHER_KEY=
# Auth mode: local (built-in login) | oidc (verify a forwarded JWT)
AUTH_MODE=local
# OIDC mode (provider-neutral — Okta/Auth0/Cognito/… or a shared static key).
# Supply EITHER a static public key (PEM, e.g. the app passthrough) OR a JWKS URI.
OIDC_PUBLIC_KEY=            # -----BEGIN PUBLIC KEY----- … (RS256 SPKI)
OIDC_JWKS_URI=             # e.g. https://<issuer>/oauth2/v1/keys
OIDC_ISSUER=              # optional; validated if set
OIDC_AUDIENCE=            # optional; validated if set
OIDC_TOKEN_COOKIE=        # optional cookie name to read the token from (else Authorization: Bearer)
# claim mapping (defaults shown)
OIDC_CLAIM_SUBJECT=sub
OIDC_CLAIM_EMAIL=email
OIDC_CLAIM_NAME=name
OIDC_CLAIM_ROLE=role

# Model + reasoning effort per role (optional). Models are discovered from the
# bundled CLI; these only choose defaults. Aliases (opus/sonnet/haiku) follow new
# releases; admins can override further in Settings → Models & Effort.
# Roles: agent, template, review_agent, reviewer, supervisor, sizing, deploy.
# DABOSS_MODEL_DEFAULTS={"agent":{"model":"opus","effort":"high"},"supervisor":{"model":"sonnet"}}

# Dev environments (per-change dev pods declared by a repo's .daboss/dev.yaml).
# Namespaces they may run in (empty = feature off) and the kubectl context name
# shown in the port-forward command. See k8s/gke/RUNBOOK.md §12.
# DABOSS_DEV_NAMESPACES=myapp
# DABOSS_DEV_KUBE_CONTEXT=my-cluster-context
# DABOSS_DEV_KUBE_SETUP=<one-time command that creates that kubectl context>
